# ==========================================
# elinkBook PocketBase 同步後端環境變數設定範例
# ==========================================

# PocketBase 版本 (必須 >= 0.23 以支援 Batch API；0.41.1 (含) 以上皆可)
PB_VERSION=0.41.1

# PocketBase 下載來源 (官方已由 GitHub 搬到此站)
# 新站無法連線時，可改回 https://github.com/pocketbase/pocketbase/releases/download
PB_BASE_URL=https://ganigeorgiev.com/meta/pocketbase/pocketbase/download

# Alpine 基底映像標籤 (預設 latest；需要可重現建置時改成固定版本，例如 3.22)
ALPINE_TAG=latest

# 容器對外暴露之 HTTP 埠號
PORT=8090

# Docker 容器名稱
CONTAINER_NAME=elinkbook-pocketbase

# 資料持久化目錄路徑
DATA_PATH=./pb_data

# PocketBase JS Hooks 掛載路徑 (含墓碑清理 purge_tombstones.pb.js)
HOOKS_PATH=./pb_hooks

# PocketBase JS Migrations 掛載路徑 (含批次建立 4 個 collection 的 migration)
MIGRATIONS_PATH=./pb_migrations
