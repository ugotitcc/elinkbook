# ─── Traefik 整合設定 ─────────────────────────────
PROXY_NETWORK=reverse-proxy

HTTP_ENTRY_POINTS=web
HTTPS_ENTRY_POINTS=websecure
CERTIFICATION_RESOLVERS=letsencrypt


# ─── 通用設定 ─────────────────────────────────────
LOADBALANCER_SERVER_PORT=80

# ─── G3 Frontend (Angular) ────────────────────────
POCKETBASE_HOST_NAME=pbdev.jigong.org
POCKETBASE_TRAEFIK_ROUTERS_NAME=pbdev


# ==========================================
# elinkBook PocketBase 同步後端環境變數設定
# ==========================================

# PocketBase 版本 (必須 >= 0.23 以支援 Batch API)
PB_VERSION=0.39.10

# 容器對外暴露之 HTTP 埠號
PORT=8090

# Docker 容器名稱
CONTAINER_NAME=elinkbook-pocketbase

# 資料持久化目錄路徑
DATA_PATH=./pb_data

# PocketBase JS Hooks 掛載路徑 (含墓碑清理 purge_tombstones.pb.js)
HOOKS_PATH=./pb_hooks

# PocketBase JS Migrations 掛載路徑 (含批次建立 4 個 collection 的 migration)
MIGRATIONS_PATH=./pb_migrations



